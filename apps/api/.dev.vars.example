# Copy to `.dev.vars` (gitignored). Read by `pnpm dev:api`, `pnpm db:migrate` and `wrangler dev`.
# Everything is optional for `pnpm dev:api`: without DATABASE_URL it uses PGlite in `.data/pglite`,
# and without BETTER_AUTH_SECRET it uses a dev-only secret.

# Enables local-only defaults: localhost and Expo Go trusted origins, CORS "*" and no rate limit.
# Required for `wrangler dev` (`dev:worker`); `pnpm dev:api` sets it by itself.
# Never set it in production: there only the API's own origin and the app scheme are trusted.
ENVIRONMENT=development

# Neon connection string. Required by `pnpm --filter @repo/api dev:worker` and in production.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Signs cookies and tokens. Generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Origins Better Auth trusts besides the API's own (web app URL, app scheme, Expo Go). With
# ENVIRONMENT=development the defaults below apply when unset.
# Add your LAN URL (e.g. http://192.168.0.10:8081) to sign in from the web on another device.
# TRUSTED_ORIGINS=http://localhost:8081,foremanapp://,exp://

# Public URL of the API (OAuth callbacks). Optional everywhere: defaults to the request's origin.
# BETTER_AUTH_URL=http://localhost:8787

# Optional OAuth. Callback URLs: <API URL>/api/auth/callback/github and .../callback/google
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
