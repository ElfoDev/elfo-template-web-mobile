{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foreman-template-web-mobile-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Non-secret config only. Secrets go in `.dev.vars` locally and `wrangler secret put` in prod:
  //   DATABASE_URL (Neon), BETTER_AUTH_SECRET, and optionally
  //   GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET.
  "vars": {
    // Comma-separated list of allowed browser origins. "*" allows any origin.
    "CORS_ORIGINS": "*"
    // Origins Better Auth trusts and that may send the session cookie (web URL + app scheme).
    // Unset = local defaults: "http://localhost:8081,foremanapp://,exp://" (see src/auth.ts).
    // "TRUSTED_ORIGINS": "https://app.example.com,foremanapp://",
    // Public URL of the API (OAuth callbacks). Unset = origin of each request.
    // "BETTER_AUTH_URL": "https://api.example.com"
  }
}
