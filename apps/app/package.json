{
  "name": "@repo/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web && node -e \"require('node:fs').copyFileSync('dist/+not-found.html', 'dist/404.html')\"",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.18",
    "@expo/vector-icons": "^15.1.1",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.7.18",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "expo-doctor": "^1.21.6",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "maxWorkers": "50%",
    "cacheDirectory": "<rootDir>/node_modules/.cache/jest",
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setup.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/style-mock.js"
    }
  }
}
