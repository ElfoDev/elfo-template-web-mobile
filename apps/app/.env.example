# Copy to `.env.local` to override. Only EXPO_PUBLIC_* vars reach the app bundle,
# and they are PUBLIC: never put secrets here.
#
# API base URL. When unset in development, the app uses the Metro host on port 8787
# (works in simulators, emulators and Expo Go on the same Wi-Fi).
# EXPO_PUBLIC_API_URL=http://localhost:8787
